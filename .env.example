# Locally, run `vercel env pull` to get the real values (database, ENCRYPTION_KEY, CRON_SECRET).
# Everything below the core section is optional. Without it the app runs on demo data:
# discovery uses a demo provider, email/payouts are simulated, AI uses templates.

# ── Core (set on Vercel) ────────────────────────────────────────────────────
DATABASE_URL=                         # Neon pooled connection (Vercel Marketplace sets this)
DATABASE_URL_UNPOOLED=                # Neon direct connection, used for schema changes
ENCRYPTION_KEY=                       # encrypts OAuth tokens + tax IDs. Must be the same everywhere that shares the database.
CRON_SECRET=                          # Vercel sends it to /api/cron/*
ADMIN_PASSWORD=                       # team password for the ops console (creator portal, webhooks and tracking links stay public)
APP_URL=                              # e.g. https://roster.example.com — used for OAuth redirects and creator links.
                                      # Register {APP_URL}/api/oauth/{tiktok,instagram,youtube}/callback with each platform.

# ── AI (Claude) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                    # openers, reply triage, variations, briefs, compliance review
CLAUDE_MODEL=claude-opus-5-5

# ── Discovery ───────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=                      # official keyword search (TikTok/IG keyword search needs a partner API or data vendor)

# ── Creator account connection (official logins) ────────────────────────────
TIKTOK_CLIENT_KEY=                    # Login Kit + Display API: user.info.basic, user.info.stats, video.list
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=                     # Instagram API with Instagram Login: instagram_business_basic, instagram_business_manage_insights
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_TOKEN=                # Business Discovery for pnpm find-emails: long-lived Facebook user token (instagram_basic, instagram_manage_insights, pages_read_engagement, pages_show_list)
INSTAGRAM_BUSINESS_ID=                # your Instagram professional account ID; found automatically if blank
GOOGLE_CLIENT_ID=                     # youtube.readonly + yt-analytics.readonly
GOOGLE_CLIENT_SECRET=

# ── Email outreach ──────────────────────────────────────────────────────────
RESEND_API_KEY=                       # use a dedicated outreach domain with SPF/DKIM/DMARC
EMAIL_FROM="Alex at Snapcal <alex@try-snapcal.com>"
EMAIL_REPLY_TO=                       # an address on your Resend receiving domain, e.g. replies@<id>.resend.app
RESEND_WEBHOOK_SECRET=                # signing secret (whsec_…) of the Resend email.received webhook
INBOUND_EMAIL_SECRET=                 # only for non-Resend inbound providers: sent as x-webhook-secret
BOOKING_WEBHOOK_SECRET=               # Calendly webhook signing key for /api/webhooks/booking (paid Calendly plan)

# ── Revenue & installs ──────────────────────────────────────────────────────
REVENUECAT_WEBHOOK_SECRET=            # set the same value as the webhook Authorization header in RevenueCat
ASC_ISSUER_ID=                        # App Store Connect API key (Sales and Trends)
ASC_KEY_ID=
ASC_PRIVATE_KEY=                      # contents of the .p8 (newlines as \n)
ASC_VENDOR_NUMBER=

# ── Payouts ─────────────────────────────────────────────────────────────────
WISE_API_TOKEN=
WISE_PROFILE_ID=
WISE_ENV=sandbox                      # or live
WISE_TARGET_CURRENCY=USD
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox                    # or live
STRIPE_SECRET_KEY=                    # Stripe Connect transfers to acct_… destinations

# Waitlist signups (signup bonus). Creator links are <APP URL>/go/<code>; the Sooz site tags waitlist rows with influencer_handle.
WAITLIST_DATABASE_URL=                 # Supabase pooler URL for the roster_sync login (reads 4 waitlist columns, lists creator handles)
SIGNUP_WEBHOOK_SECRET=                 # optional: lets other tools POST signups to /api/signups
